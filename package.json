{
  "name": "@dsdenes/ajv-turbo",
  "version": "8.20.0",
  "description": "Drop-in JSON Schema validator for ajv, verdict- and error-report-compatible for draft-06, draft-07, 2019-09, and 2020-12 validation, the formats and keyword-extension plugins, registered custom keywords, ajv data references, discriminators, asynchronous validation, asynchronous loading of missing schema references, and JSON Type Definition validation, text parsing, and text generation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsdenes/ajv-turbo.git"
  },
  "bugs": {
    "url": "https://github.com/dsdenes/ajv-turbo/issues"
  },
  "homepage": "https://github.com/dsdenes/ajv-turbo#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./dist/ajv": "./dist/ajv.js",
    "./dist/ajv.js": "./dist/ajv.js",
    "./dist/2019": {
      "types": "./dist/2019.d.ts",
      "import": "./dist/2019.js",
      "require": "./dist/2019.js",
      "default": "./dist/2019.js"
    },
    "./dist/2019.js": "./dist/2019.js",
    "./dist/2020": {
      "types": "./dist/2020.d.ts",
      "import": "./dist/2020.js",
      "require": "./dist/2020.js",
      "default": "./dist/2020.js"
    },
    "./dist/2020.js": "./dist/2020.js",
    "./dist/jtd": {
      "types": "./dist/jtd.d.ts",
      "import": "./dist/jtd.js",
      "require": "./dist/jtd.js",
      "default": "./dist/jtd.js"
    },
    "./dist/jtd.js": "./dist/jtd.js",
    "./dist/standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js",
      "require": "./dist/standalone.js",
      "default": "./dist/standalone.js"
    },
    "./dist/standalone.js": "./dist/standalone.js",
    "./dist/standalone/index": "./dist/standalone/index.js",
    "./dist/standalone/index.js": "./dist/standalone/index.js",
    "./dist/standalone/instance": {
      "types": "./dist/standalone/instance.d.ts",
      "import": "./dist/standalone/instance.js",
      "require": "./dist/standalone/instance.js",
      "default": "./dist/standalone/instance.js"
    },
    "./dist/standalone/instance.js": "./dist/standalone/instance.js",
    "./dist/compile/codegen": "./dist/compile/codegen.js",
    "./dist/compile/codegen.js": "./dist/compile/codegen.js",
    "./dist/runtime/*": "./dist/runtime/*.js",
    "./dist/runtime/*.js": "./dist/runtime/*.js",
    "./lib/*": "./lib/*",
    "./dist/refs/*": "./dist/refs/*",
    "./package.json": "./package.json",
    "./dist/core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./dist/core.js": "./dist/core.js",
    "./dist/compile/codegen/code": "./dist/compile/codegen/code.js",
    "./dist/compile/codegen/code.js": "./dist/compile/codegen/code.js",
    "./dist/compile/codegen/index": "./dist/compile/codegen/index.js",
    "./dist/compile/codegen/index.js": "./dist/compile/codegen/index.js",
    "./dist/compile/codegen/scope": "./dist/compile/codegen/scope.js",
    "./dist/compile/codegen/scope.js": "./dist/compile/codegen/scope.js",
    "./dist/refs/json-schema-2019-09": "./dist/refs/json-schema-2019-09/index.js",
    "./dist/refs/json-schema-2019-09/index": "./dist/refs/json-schema-2019-09/index.js",
    "./dist/refs/json-schema-2019-09/index.js": "./dist/refs/json-schema-2019-09/index.js",
    "./dist/refs/json-schema-2020-12": "./dist/refs/json-schema-2020-12/index.js",
    "./dist/refs/json-schema-2020-12/index": "./dist/refs/json-schema-2020-12/index.js",
    "./dist/refs/json-schema-2020-12/index.js": "./dist/refs/json-schema-2020-12/index.js",
    "./dist/refs/jtd-schema": "./dist/refs/jtd-schema.js",
    "./dist/refs/jtd-schema.js": "./dist/refs/jtd-schema.js",
    "./dist/types/*": "./dist/types/*.js",
    "./dist/types/*.js": "./dist/types/*.js"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "lib/",
    "dist/"
  ],
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify": "node test/verify.js",
    "bench": "node bench/runner.js"
  },
  "devDependencies": {
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "ajv-reference": "npm:ajv@8.20.0",
    "benchmark": "^2.1.4"
  },
  "dependencies": {
    "fast-uri": "^3.0.1"
  }
}
