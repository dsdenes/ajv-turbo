{
  "name": "ajv",
  "version": "8.20.0",
  "description": "Drop-in JSON Schema validator for ajv, verdict- and error-report-compatible for draft-07 and 2019-09 validation, registered formats, registered custom keywords, and asynchronous validation",
  "license": "MIT",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./dist/ajv": "./dist/ajv.js",
    "./dist/ajv.js": "./dist/ajv.js",
    "./dist/2019": {
      "types": "./dist/2019.d.ts",
      "import": "./dist/2019.js",
      "require": "./dist/2019.js",
      "default": "./dist/2019.js"
    },
    "./dist/2019.js": "./dist/2019.js",
    "./lib/*": "./lib/*",
    "./dist/refs/*": "./dist/refs/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "lib/",
    "dist/"
  ],
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify": "node test/verify.js",
    "bench": "node bench/runner.js"
  },
  "devDependencies": {
    "ajv-reference": "npm:ajv@8.20.0",
    "benchmark": "^2.1.4"
  }
}
