{
  "name": "ajv",
  "version": "8.20.0",
  "description": "Drop-in JSON Schema validator for ajv, verdict- and error-report-compatible for draft-07, 2019-09, and 2020-12 validation, registered formats, registered custom keywords, ajv data references, discriminators, asynchronous validation, and JSON Type Definition validation, text parsing, and text generation",
  "license": "MIT",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./dist/ajv": "./dist/ajv.js",
    "./dist/ajv.js": "./dist/ajv.js",
    "./dist/2019": {
      "types": "./dist/2019.d.ts",
      "import": "./dist/2019.js",
      "require": "./dist/2019.js",
      "default": "./dist/2019.js"
    },
    "./dist/2019.js": "./dist/2019.js",
    "./dist/2020": {
      "types": "./dist/2020.d.ts",
      "import": "./dist/2020.js",
      "require": "./dist/2020.js",
      "default": "./dist/2020.js"
    },
    "./dist/2020.js": "./dist/2020.js",
    "./dist/jtd": {
      "types": "./dist/jtd.d.ts",
      "import": "./dist/jtd.js",
      "require": "./dist/jtd.js",
      "default": "./dist/jtd.js"
    },
    "./dist/jtd.js": "./dist/jtd.js",
    "./dist/standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js",
      "require": "./dist/standalone.js",
      "default": "./dist/standalone.js"
    },
    "./dist/standalone.js": "./dist/standalone.js",
    "./dist/standalone/index": "./dist/standalone/index.js",
    "./dist/standalone/index.js": "./dist/standalone/index.js",
    "./dist/standalone/instance": {
      "types": "./dist/standalone/instance.d.ts",
      "import": "./dist/standalone/instance.js",
      "require": "./dist/standalone/instance.js",
      "default": "./dist/standalone/instance.js"
    },
    "./dist/standalone/instance.js": "./dist/standalone/instance.js",
    "./dist/runtime/*": "./dist/runtime/*.js",
    "./dist/runtime/*.js": "./dist/runtime/*.js",
    "./lib/*": "./lib/*",
    "./dist/refs/*": "./dist/refs/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "lib/",
    "dist/"
  ],
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify": "node test/verify.js",
    "bench": "node bench/runner.js"
  },
  "devDependencies": {
    "ajv-reference": "npm:ajv@8.20.0",
    "benchmark": "^2.1.4"
  }
}
