{
  "$id": "https://standalone.example/catalog",
  "type": "object",
  "definitions": {
    "money": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 1000000
    },
    "item": {
      "type": "object",
      "required": [
        "sku",
        "price"
      ],
      "additionalProperties": false,
      "properties": {
        "sku": {
          "type": "string",
          "pattern": "^[A-Z]{3}-[0-9]+$"
        },
        "price": {
          "$ref": "#/definitions/money"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        }
      }
    }
  },
  "required": [
    "items",
    "mode"
  ],
  "properties": {
    "mode": {
      "enum": [
        "retail",
        "wholesale"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "coupon": {
      "$ref": "https://standalone.example/coupon"
    },
    "shipping": {
      "if": {
        "type": "object",
        "properties": {
          "mode": {
            "const": "wholesale"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "carrier"
        ],
        "properties": {
          "carrier": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "type": "object",
        "required": [
          "address"
        ],
        "properties": {
          "address": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "retail"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "wholesale"
            }
          }
        }
      ]
    }
  ]
}
