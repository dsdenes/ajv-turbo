{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "type": "object",
  "required": ["plan", "seats"],
  "properties": {
    "plan": {"const": "team"},
    "seats": {"type": "integer", "exclusiveMinimum": 0},
    "features": {
      "type": "array",
      "minItems": 1,
      "contains": {"enum": ["sso", "audit"]}
    },
    "owner": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z]+$"},
      "additionalProperties": {"type": "string"}
    },
    "addons": {
      "type": "array",
      "items": [{"const": "backup"}],
      "additionalItems": false,
      "minItems": 1,
      "maxItems": 1
    }
  }
}
